<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="Ribbon_OnLoad">
  <ribbon>
    <tabs>
      <tab id="customTab_MORProcedures" label="MOR Procedures" insertBeforeMso="TabHelp">
        <group id="grpDataMasking" label="Data Privacy &amp; Masking">
          <button id="btnMaskSelection"
                  label="Scramble Selection (Ctrl+Shift+M)"
                  image="lock"
                  size="large"
                  onAction="OnRibbonMaskClick"/>
          <button id="btnUnmaskSelection"
                  label="Restore Selection (Ctrl+Shift+U)"
                  image="unlock"
                  size="large"
                  onAction="OnRibbonUnmaskClick"/>
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
